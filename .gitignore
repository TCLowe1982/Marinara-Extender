
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Environment files — never commit secrets
.env
.env.local
memory-extender/.env

# Build output
memory-extender/dist/

# Saved-page / design-reference captures (third-party assets, not our source)
*_files/
node_modules

# Sidecar data quarantine/backup copies (user data, never source)
marinara-extender-backups/

# Local working notes (bug reports, drafts) - published artifacts live elsewhere
local-notes/

# Tripwire log: local ingestion telemetry, not shared state.
memory-extender/data/bait-contamination.jsonl
memory-extender/data/ops-lane.jsonl

# pre-push transcripts (self-evidencing gate)
memory-extender/logs/pre-push.log

# Bench scratch (cye6) — regenerable from the seed; never committed.
memory-extender/scratch/

# Repair backups — live store content. Same reason data/ is ignored.
memory-extender/backups/

# wosh audit — LOCAL ONLY. Holds real user messages verbatim; this repo is public.
corpus-cache.json
memory-extender/corpus-cache.json
memory-extender/src/__tests__/fixtures.local.json
