diff --git a/packages/server/src/services/generation/prompt-context-contributors.ts b/packages/server/src/services/generation/prompt-context-contributors.ts
new file mode 100644
index 000000000..a436ee696
--- /dev/null
+++ b/packages/server/src/services/generation/prompt-context-contributors.ts
@@ -0,0 +1,162 @@
+import type { ChatMode } from "@marinara-engine/shared";
+import { getAgentCallTimeoutMs } from "../../config/runtime-config.js";
+import { logger } from "../../lib/logger.js";
+import { getCapabilityService } from "../capability-packages/capability-service-registry.service.js";
+import { withLlmRequestTimeout } from "../llm/base-provider.js";
+
+/**
+ * Generic prompt-context contribution for capability packages.
+ *
+ * A package that wants to add retrieved context to a generation registers a
+ * service under `<agentId>:prompt-context`, where `<agentId>` is the id of an
+ * agent the package declares. The generation route already knows which agents
+ * are active for a chat, so no registry or discovery mechanism is required —
+ * the key is derived from data the caller already holds.
+ *
+ * This is the same integration shape as `long-term-memory-runtime.ts`, minus
+ * the hard-coded feature key. That file resolves exactly one service name, so
+ * every additional contributor would otherwise need its own Engine-side module
+ * and its own call site. Here the Engine states the contract once and any
+ * package — first- or third-party — satisfies it without further Engine
+ * changes.
+ *
+ * Nothing happens unless a package registers. `getCapabilityService` returns
+ * null for an unregistered key, so an install with no participating packages
+ * takes one map lookup per active agent and contributes nothing.
+ */
+
+const SERVICE_SUFFIX = ":prompt-context";
+
+/** Matches the recall cap in `long-term-memory-runtime.ts`. */
+const MAX_CONTRIBUTION_CHARACTERS = 100_000;
+
+/** Opaque to the Engine; handed back verbatim on acceptance. */
+export type PromptContextReceipt = unknown;
+
+export interface PromptContextContribution {
+  text: string;
+  receipt?: PromptContextReceipt;
+}
+
+export interface PromptContextContributorService {
+  /**
+   * Return context to inject for this generation, or null to contribute
+   * nothing. Called after the prompt messages are assembled, so `messages`
+   * reflects what the model is about to receive.
+   */
+  contribute(input: {
+    chatId: string;
+    chatMode: ChatMode;
+    characterIds: string[];
+    messages: Array<{ role: "system" | "user" | "assistant"; content: string }>;
+    signal?: AbortSignal;
+    debugMode: boolean;
+  }): Promise<PromptContextContribution | null>;
+  /**
+   * Called once the contributed text is confirmed present in the dispatched
+   * prompt. Optional: a contributor that does not track usage may omit it.
+   */
+  recordPromptAccepted?(input: {
+    chatId: string;
+    receipt: PromptContextReceipt;
+    messages: Array<{ role: string; content: string }>;
+  }): Promise<void>;
+}
+
+/** A contribution paired with the agent that produced it. */
+export interface CollectedPromptContext {
+  agentId: string;
+  text: string;
+  receipt?: PromptContextReceipt;
+}
+
+function contributorFor(agentId: string) {
+  return getCapabilityService<PromptContextContributorService>(`${agentId}${SERVICE_SUFFIX}`);
+}
+
+/**
+ * Bound a contributor call so a stalled package cannot hold up a turn.
+ * Mirrors `withLongTermMemoryRuntimeTimeout`; kept local so this module stays
+ * additive and does not require editing the existing long-term-memory path.
+ */
+export async function withPromptContextTimeout<T>(
+  timeoutMs: number,
+  operation: (signal: AbortSignal) => Promise<T>,
+  signal?: AbortSignal,
+): Promise<T> {
+  const timeoutController = new AbortController();
+  const combinedSignal = signal ? AbortSignal.any([signal, timeoutController.signal]) : timeoutController.signal;
+  const timeoutError = new Error(`Prompt-context contribution timed out after ${timeoutMs} ms`);
+  let rejectOnAbort: (() => void) | undefined;
+  const aborted = new Promise<never>((_, reject) => {
+    rejectOnAbort = () => {
+      reject(combinedSignal.reason instanceof Error ? combinedSignal.reason : timeoutError);
+    };
+    if (combinedSignal.aborted) rejectOnAbort();
+    else combinedSignal.addEventListener("abort", rejectOnAbort, { once: true });
+  });
+  const timeout = setTimeout(() => timeoutController.abort(timeoutError), timeoutMs);
+  try {
+    return await withLlmRequestTimeout(timeoutMs, () => Promise.race([operation(combinedSignal), aborted]));
+  } finally {
+    clearTimeout(timeout);
+    if (rejectOnAbort) combinedSignal.removeEventListener("abort", rejectOnAbort);
+  }
+}
+
+/**
+ * Collect contributions from every active agent that registered one.
+ *
+ * Contributors run sequentially in `agentIds` order so injection order is
+ * deterministic across turns rather than dependent on which package answered
+ * first. A contributor that fails, times out, or returns empty text is skipped;
+ * a failing package must degrade to "no extra context", never to a failed turn.
+ */
+export async function collectPromptContextContributions(
+  agentIds: readonly string[],
+  input: Parameters<PromptContextContributorService["contribute"]>[0],
+): Promise<CollectedPromptContext[]> {
+  const collected: CollectedPromptContext[] = [];
+  for (const agentId of agentIds) {
+    const service = contributorFor(agentId);
+    if (!service) continue;
+    if (input.signal?.aborted) break;
+    try {
+      const contribution = await withPromptContextTimeout(
+        getAgentCallTimeoutMs(),
+        (signal) => service.contribute({ ...input, signal }),
+        input.signal,
+      );
+      const text = contribution?.text.trim().slice(0, MAX_CONTRIBUTION_CHARACTERS) ?? "";
+      if (text) collected.push({ agentId, text, receipt: contribution?.receipt ?? null });
+    } catch (error) {
+      if (input.signal?.aborted) break;
+      logger.warn(error, "Prompt-context contribution from %s failed; continuing without it", agentId);
+    }
+  }
+  return collected;
+}
+
+/**
+ * Confirm to a contributor that its text reached the dispatched prompt.
+ *
+ * Separate from collection because contributing and shipping are different
+ * events: a contribution can be assembled and then dropped by preset placement
+ * or an aborted request. Accounting that assumed otherwise would over-report.
+ */
+export async function recordPromptContextAccepted(
+  agentId: string,
+  input: {
+    chatId: string;
+    receipt: PromptContextReceipt;
+    messages: Array<{ role: string; content: string }>;
+  },
+): Promise<void> {
+  const service = contributorFor(agentId);
+  if (!service?.recordPromptAccepted) return;
+  try {
+    await withPromptContextTimeout(getAgentCallTimeoutMs(), () => service.recordPromptAccepted!(input));
+  } catch (error) {
+    logger.warn(error, "Prompt-context accounting for %s failed", agentId);
+  }
+}
diff --git a/scripts/regressions/prompt-context-contributors.regression.ts b/scripts/regressions/prompt-context-contributors.regression.ts
new file mode 100644
index 000000000..9465f9f7f
--- /dev/null
+++ b/scripts/regressions/prompt-context-contributors.regression.ts
@@ -0,0 +1,178 @@
+import assert from "node:assert/strict";
+
+import {
+  registerCapabilityService,
+  resetCapabilityServices,
+} from "../../packages/server/src/services/capability-packages/capability-service-registry.service.js";
+import {
+  collectPromptContextContributions,
+  recordPromptContextAccepted,
+  withPromptContextTimeout,
+  type PromptContextContributorService,
+} from "../../packages/server/src/services/generation/prompt-context-contributors.js";
+
+type ContributeInput = Parameters<PromptContextContributorService["contribute"]>[0];
+
+function input(overrides: Partial<ContributeInput> = {}): ContributeInput {
+  return {
+    chatId: "chat-1",
+    chatMode: "roleplay",
+    characterIds: ["char-1"],
+    messages: [{ role: "user", content: "hello" }],
+    debugMode: false,
+    ...overrides,
+  } as ContributeInput;
+}
+
+function contributor(
+  impl: Partial<PromptContextContributorService>,
+): PromptContextContributorService {
+  return { contribute: async () => null, ...impl } as PromptContextContributorService;
+}
+
+// An Engine carrying this seam with no participating package must behave
+// exactly as it did before. This is the property the whole change rests on.
+{
+  resetCapabilityServices();
+  const collected = await collectPromptContextContributions(["long-term-memory", "anything"], input());
+  assert.deepEqual(collected, [], "unregistered agents must contribute nothing");
+}
+
+// A registered contributor is collected, tagged with its agent id, and its
+// receipt is passed through untouched.
+{
+  resetCapabilityServices();
+  const receipt = { id: "receipt-1" };
+  registerCapabilityService(
+    "marinara-extender:prompt-context",
+    contributor({ contribute: async () => ({ text: "  remembered thing  ", receipt }) }),
+  );
+  const collected = await collectPromptContextContributions(["marinara-extender"], input());
+  assert.equal(collected.length, 1);
+  assert.equal(collected[0]!.agentId, "marinara-extender");
+  assert.equal(collected[0]!.text, "remembered thing", "text must be trimmed");
+  assert.equal(collected[0]!.receipt, receipt, "receipt must pass through by reference");
+}
+
+// Injection order must follow the caller's agent order, not whichever package
+// happened to resolve first — otherwise prompt content reorders between turns.
+{
+  resetCapabilityServices();
+  registerCapabilityService("alpha:prompt-context", contributor({ contribute: async () => ({ text: "A" }) }));
+  registerCapabilityService("beta:prompt-context", contributor({ contribute: async () => ({ text: "B" }) }));
+  const forward = await collectPromptContextContributions(["alpha", "beta"], input());
+  const reverse = await collectPromptContextContributions(["beta", "alpha"], input());
+  assert.deepEqual(forward.map((c) => c.text), ["A", "B"]);
+  assert.deepEqual(reverse.map((c) => c.text), ["B", "A"]);
+}
+
+// A failing package degrades to "no extra context" and must not prevent other
+// contributors from running, nor fail the turn.
+{
+  resetCapabilityServices();
+  registerCapabilityService(
+    "broken:prompt-context",
+    contributor({
+      contribute: async () => {
+        throw new Error("contributor exploded");
+      },
+    }),
+  );
+  registerCapabilityService("healthy:prompt-context", contributor({ contribute: async () => ({ text: "kept" }) }));
+  const collected = await collectPromptContextContributions(["broken", "healthy"], input());
+  assert.deepEqual(collected.map((c) => c.agentId), ["healthy"], "a throwing contributor is skipped, not fatal");
+}
+
+// Empty and whitespace-only contributions are dropped so they cannot introduce
+// blank sections into the prompt.
+{
+  resetCapabilityServices();
+  registerCapabilityService("blank:prompt-context", contributor({ contribute: async () => ({ text: "   \n  " }) }));
+  registerCapabilityService("null:prompt-context", contributor({ contribute: async () => null }));
+  const collected = await collectPromptContextContributions(["blank", "null"], input());
+  assert.deepEqual(collected, [], "empty contributions must not reach the prompt");
+}
+
+// A runaway contributor cannot blow the prompt budget.
+{
+  resetCapabilityServices();
+  registerCapabilityService(
+    "huge:prompt-context",
+    contributor({ contribute: async () => ({ text: "x".repeat(250_000) }) }),
+  );
+  const collected = await collectPromptContextContributions(["huge"], input());
+  assert.equal(collected[0]!.text.length, 100_000, "contribution must be capped");
+}
+
+// An already-aborted request does no contributor work at all.
+{
+  resetCapabilityServices();
+  let called = false;
+  registerCapabilityService(
+    "aborted:prompt-context",
+    contributor({
+      contribute: async () => {
+        called = true;
+        return { text: "should not happen" };
+      },
+    }),
+  );
+  const controller = new AbortController();
+  controller.abort();
+  const collected = await collectPromptContextContributions(["aborted"], input({ signal: controller.signal }));
+  assert.deepEqual(collected, []);
+  assert.equal(called, false, "an aborted request must not invoke contributors");
+}
+
+// A stalled contributor must not hold a turn open indefinitely.
+{
+  const started = Date.now();
+  await assert.rejects(
+    () => withPromptContextTimeout(50, () => new Promise(() => {})),
+    /timed out after 50 ms/,
+    "a hung contributor must reject on the timeout",
+  );
+  assert.ok(Date.now() - started < 5_000, "timeout must fire promptly");
+}
+
+// recordPromptAccepted is optional; a contributor without it must not throw.
+{
+  resetCapabilityServices();
+  registerCapabilityService("minimal:prompt-context", contributor({ contribute: async () => ({ text: "t" }) }));
+  await recordPromptContextAccepted("minimal", { chatId: "chat-1", receipt: null, messages: [] });
+}
+
+// When present, acceptance is reported with the original receipt.
+{
+  resetCapabilityServices();
+  let seen: unknown = "unset";
+  registerCapabilityService(
+    "accounting:prompt-context",
+    contributor({
+      contribute: async () => ({ text: "t", receipt: { n: 7 } }),
+      recordPromptAccepted: async ({ receipt }) => {
+        seen = receipt;
+      },
+    }),
+  );
+  await recordPromptContextAccepted("accounting", { chatId: "chat-1", receipt: { n: 7 }, messages: [] });
+  assert.deepEqual(seen, { n: 7 }, "the contributor's own receipt must be handed back");
+}
+
+// Accounting failures are contained the same way contribution failures are.
+{
+  resetCapabilityServices();
+  registerCapabilityService(
+    "bad-accounting:prompt-context",
+    contributor({
+      contribute: async () => ({ text: "t" }),
+      recordPromptAccepted: async () => {
+        throw new Error("accounting exploded");
+      },
+    }),
+  );
+  await recordPromptContextAccepted("bad-accounting", { chatId: "chat-1", receipt: null, messages: [] });
+}
+
+resetCapabilityServices();
+console.log("prompt-context contributor regression passed");
