+        let promptContextContributions: CollectedPromptContext[] = [];
+        let promptContextRecorded = false;
         const ownerSpatialProjection = await ownerSpatialProjectionPromise;
         let conversationCommandsReminder: string | null = null;
         let conversationContextMacroSlots: ConversationContextMacroSlots = {
@@ -1642,6 +1650,14 @@ export async function generateRoutes(app: FastifyInstance) {
         if (chatEnableAgents && chatActiveAgentIds.includes("long-term-memory")) {
           runtimeSectionEligibleAgentTypes.add("long-term-memory");
         }
+        // A package that contributes prompt context may own a preset placement
+        // slot too. Only agents that actually registered a contributor are made
+        // eligible, so a slot is never reserved for an agent that supplies none.
+        if (chatEnableAgents) {
+          for (const agentId of chatActiveAgentIds) {
+            if (hasPromptContextContributor(agentId)) runtimeSectionEligibleAgentTypes.add(agentId);
+          }
+        }
         const chatActiveLorebookIds: string[] = Array.isArray(chatMeta.activeLorebookIds)
           ? (chatMeta.activeLorebookIds as string[])
           : [];
@@ -4676,6 +4692,35 @@ export async function generateRoutes(app: FastifyInstance) {
             }
           }
         }
+        // Capability packages that registered a prompt-context contributor for an
+        // active agent. Placed and budgeted exactly like the long-term-memory block
+        // above; the difference is that the contract is generic, so no Engine change
+        // is needed per package. Gated on !regenerateMessageId to match that block —
+        // a re-roll reuses the context assembled for the original generation.
+        if (chatEnableAgents && chatActiveAgentIds.length > 0 && !input.regenerateMessageId) {
+          const contributed = await collectPromptContextContributions(
+            chatActiveAgentIds.filter((agentId) => agentId !== "long-term-memory"),
+            {
+              chatId: input.chatId,
+              chatMode,
+              characterIds: promptCharacterIds,
+              messages: finalMessages.map(({ role, content }) => ({ role, content })),
+              signal: abortController.signal,
+              debugMode: requestDebug || isDebug,
+            },
+          );
+          for (const contribution of contributed) {
+            const tokens = runtimeAgentSectionTokens.get(contribution.agentId);
+            const handledByPresetSection =
+              tokens !== undefined && replaceRuntimeAgentSection(finalMessages, tokens, contribution.text);
+            if (!handledByPresetSection && presetOwnsAgentPlacement) continue;
+            if (!handledByPresetSection) appendSeparateAgentInjection(contribution.agentId, contribution.text);
+            contextInjections.push({ agentType: contribution.agentId, text: contribution.text });
+            // Only contributions that actually reached the prompt are eligible for
+            // acceptance accounting; one dropped by preset placement is not.
+            promptContextContributions.push(contribution);
+          }
+        }
         clearUnusedRuntimeAgentSections(finalMessages, runtimeAgentSectionTokens);
 
         if (directorSecretPlotAgent) {
@@ -5432,6 +5477,19 @@ export async function generateRoutes(app: FastifyInstance) {
             });
           };
 
+          const recordAcceptedPromptContext = async (messages: ChatMessage[]) => {
+            if (promptContextRecorded || promptContextContributions.length === 0) return;
+            promptContextRecorded = true;
+            const dispatched = messages.map(({ role, content }) => ({ role, content }));
+            for (const contribution of promptContextContributions) {
+              await recordPromptContextAccepted(contribution.agentId, {
+                chatId: input.chatId,
+                receipt: contribution.receipt ?? null,
+                messages: dispatched,
+              });
+            }
+          };
+
           if (enableChatTools && provider.chatComplete) {
             const maxToolRounds = getMaxToolRounds();
             let loopMessages: ChatMessage[] = initialProviderMessages;
@@ -5530,6 +5588,7 @@ export async function generateRoutes(app: FastifyInstance) {
                   }),
                 );
                 await recordAcceptedLongTermMemoryPrompt(loopMessages);
+                await recordAcceptedPromptContext(loopMessages);
               } catch (err: any) {
                 // If the error was caused by an abort, cancel silently and skip post-processing.
                 if (abortController.signal.aborted || (err && err.name === "AbortError")) {
@@ -5814,6 +5873,7 @@ export async function generateRoutes(app: FastifyInstance) {
             try {
               let result = await withLlmRequestTimeout(chatGenerationTimeoutMs, () => gen.next());
               await recordAcceptedLongTermMemoryPrompt(initialProviderMessages);
+              await recordAcceptedPromptContext(initialProviderMessages);
               while (!result.done) {
                 if (abortController.signal.aborted) {
                   return null;
diff --git a/packages/server/src/services/generation/prompt-context-contributors.ts b/packages/server/src/services/generation/prompt-context-contributors.ts
index a436ee696..e74b387ee 100644
--- a/packages/server/src/services/generation/prompt-context-contributors.ts
+++ b/packages/server/src/services/generation/prompt-context-contributors.ts
@@ -74,6 +74,15 @@ function contributorFor(agentId: string) {
   return getCapabilityService<PromptContextContributorService>(`${agentId}${SERVICE_SUFFIX}`);
 }
 
+/**
+ * Whether an agent has a registered contributor. Lets the caller decide, before
+ * assembling the prompt, that this agent may own a preset placement slot —
+ * without reserving a slot for every active agent.
+ */
+export function hasPromptContextContributor(agentId: string): boolean {
+  return contributorFor(agentId) !== null;
+}
+
 /**
