+// ──────────────────────────────────────────────
+// Turn-Complete Notification — one-way outbound ping
+// ──────────────────────────────────────────────
+// Notifies a locally configured companion tool that a conversation turn
+// finished, so it does not have to poll `chats.lastMessageAt` on a timer.
+//
+// Identifiers only — no message bodies. A consumer reads content through the
+// existing API, which keeps this payload free of size, PII, and serialization
+// concerns, and means the notification never has to change when message shape
+// does.
+//
+// Disabled unless TURN_NOTIFY_URL is set. Same posture as discord-webhook.ts:
+// fire-and-forget, errors logged, never thrown to callers.
+
+import { logger } from "../lib/logger.js";
+import { safeFetch } from "../utils/security.js";
+
+/** Give up quickly — a stalled consumer must never hold a generation open. */
+const REQUEST_TIMEOUT_MS = 2000;
+
+export interface TurnCompletePayload {
+  chatId: string;
+  /**
+   * The user message that opened this turn. Null for turns the user did not
+   * start — autonomous messages and greetings.
+   */
+  userMessageId: string | null;
+  /**
+   * The assistant message that closed it — a new message, a regenerated swipe,
+   * or a continuation. Required: a turn with no assistant message did not
+   * complete, and callers must not announce it.
+   */
+  assistantMessageId: string;
+  /** Replying character, so a consumer need not re-read the message to route it. */
+  characterId: string | null;
+  /** ISO-8601, when the turn completed. */
+  at: string;
+}
+
+/**
+ * Read at call time, not module load, so a TURN_NOTIFY_URL edited in .env
+ * takes effect without a restart (runtime-config re-populates process.env).
+ */
+function configuredUrl(): string | null {
+  const raw = process.env.TURN_NOTIFY_URL?.trim();
+  if (!raw) return null;
+  try {
+    const parsed = new URL(raw);
+    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+      logger.warn("[turn-notify] Ignoring TURN_NOTIFY_URL: only http and https are supported");
+      return null;
+    }
+    return parsed.toString();
+  } catch {
+    logger.warn("[turn-notify] Ignoring TURN_NOTIFY_URL: not a valid URL");
+    return null;
+  }
+}
+
+/**
+ * Announce that a turn completed. No-op unless TURN_NOTIFY_URL is configured.
+ *
+ * Fire-and-forget by design: this runs on the generation path, so it must never
+ * block, throw, or fail a turn because a companion tool is down or slow.
+ */
+export function notifyTurnComplete(payload: TurnCompletePayload): void {
+  const url = configuredUrl();
+  if (!url) return;
+
+  void (async () => {
+    try {
+      const res = await safeFetch(url, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(payload),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+        maxResponseBytes: 4 * 1024,
+        allowMissingContentType: true,
+        policy: {
+          // The operator opted in by setting TURN_NOTIFY_URL in .env, at the
+          // same trust level as DATA_DIR or ADMIN_SECRET. Companion tools are
+          // expected to run on the same host, so loopback must be reachable.
+          allowLocal: true,
+          allowLoopback: true,
+          allowedProtocols: ["http:", "https:"],
+          // A notification target that redirects is misconfigured, not routed.
+          maxRedirects: 0,
+          flagName: "TURN_NOTIFY_URL",
+        },
+      });
+      if (!res.ok) {
+        logger.warn("[turn-notify] POST failed (%d)", res.status);
+      }
+    } catch (err) {
+      // Includes the timeout above. Logged at debug: a companion tool being
+      // absent is an ordinary state, not an engine fault, and this fires on
+      // every turn.
+      logger.debug(err, "[turn-notify] Notification failed");
+    }
+  })();
+}
