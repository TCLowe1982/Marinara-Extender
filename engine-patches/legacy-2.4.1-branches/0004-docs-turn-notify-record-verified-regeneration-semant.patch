From fa31471ada577d649a6cb37ce3c4f8aa39295c7d Mon Sep 17 00:00:00 2001
From: TC Lowe <111537227+TCLowe1982@users.noreply.github.com>
Date: Thu, 30 Jul 2026 17:45:56 -0500
Subject: [PATCH 4/4] docs(turn-notify): record verified regeneration semantics

A regeneration rewrites the assistant message in place, so it re-announces
an id the consumer has already seen and carries a null userMessageId.
Verified against a live generation and swipe on the dev instance.

Consumers must upsert on (chatId, assistantMessageId) rather than append,
or every swipe duplicates their record of the turn.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 packages/server/src/services/turn-notify.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/packages/server/src/services/turn-notify.ts b/packages/server/src/services/turn-notify.ts
index 0f243f5fe..d91d194bb 100644
--- a/packages/server/src/services/turn-notify.ts
+++ b/packages/server/src/services/turn-notify.ts
@@ -22,13 +22,18 @@ export interface TurnCompletePayload {
   chatId: string;
   /**
    * The user message that opened this turn. Null for turns the user did not
-   * start — autonomous messages and greetings.
+   * start — autonomous messages, greetings, and regenerations.
    */
   userMessageId: string | null;
   /**
    * The assistant message that closed it — a new message, a regenerated swipe,
    * or a continuation. Required: a turn with no assistant message did not
    * complete, and callers must not announce it.
+   *
+   * Not unique per notification. A regeneration rewrites the existing message
+   * in place, so it re-announces an id the consumer has already seen, with new
+   * content behind it. Consumers must key on (chatId, assistantMessageId) as an
+   * upsert, not an append, or every swipe duplicates their record of the turn.
    */
   assistantMessageId: string;
   /** Replying character, so a consumer need not re-read the message to route it. */
